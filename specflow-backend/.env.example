PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/specflow
# Secrets must be at least 32 characters
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
# Production requires https:// with no trailing slash
FRONTEND_URL=http://localhost:5173
# Set true on Render when Vercel proxies /api (first-party refresh cookie)
# REFRESH_COOKIE_FIRST_PARTY=true
NODE_ENV=development
